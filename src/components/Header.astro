---
// N9 · edge-aligned minimal. On the home page the masthead carries the site's
// name, so the nav drops the wordmark and keeps only its links — the name is
// never printed twice on the same screen.
interface Props {
	home?: boolean;
}

const { home = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/writing/', label: 'Writing' },
	{ href: '/about/', label: 'About' },
];
const isCurrent = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<div class:list={['n9', { 'is-home': home }]}>
	{!home && <a class="mark" href="/">Run the <span class="hl">Numbers</span></a>}
	<nav>
		{
			links.map((l) => (
				<a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
					{l.label}
				</a>
			))
		}
	</nav>
</div>
