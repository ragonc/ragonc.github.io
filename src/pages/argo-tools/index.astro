---
// -> src/pages/argo-tools/index.astro
// Section index. Short intro, then the posts. The origin story that used to live
// here is now a post: src/content/argo-tools/how-it-works.md
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const all = (await getCollection('argo-tools')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const intro = all.find((p) => p.id === 'how-it-works');
const posts = all.filter((p) => p.id !== 'how-it-works');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Argo tools | ${SITE_TITLE}`}
			description="The setup that runs my admin and side projects, and the tools that came out of it."
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			h1 {
				margin: 0 0 0.3em 0;
			}
			.lede {
				color: rgb(var(--gray-dark));
				font-size: 1.15em;
				line-height: 1.5;
				margin: 0 0 2.5em 0;
			}
			.start {
				display: block;
				text-decoration: none;
				color: inherit;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				padding: 1.2em 1.4em;
				margin: 0 0 3em 0;
				transition: border-color 0.2s ease;
			}
			.start:hover {
				border-color: var(--accent);
			}
			.start .kicker {
				display: block;
				font-size: 0.75em;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray));
				margin-bottom: 0.5em;
			}
			.start h2 {
				margin: 0 0 0.3em 0;
				font-size: 1.35em;
			}
			.start p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			h2.section {
				font-size: 0.8em;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray));
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.6em;
				margin: 0 0 1.5em 0;
			}
			ul.posts {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			ul.posts li {
				padding: 0 0 1.6em 0;
				margin: 0 0 1.6em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul.posts li:last-child {
				border-bottom: none;
				margin-bottom: 0;
			}
			ul.posts a {
				text-decoration: none;
				color: inherit;
			}
			ul.posts h3 {
				margin: 0 0 0.25em 0;
				font-size: 1.2em;
			}
			ul.posts a:hover h3 {
				color: var(--accent);
			}
			ul.posts .date {
				margin: 0 0 0.4em 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			ul.posts .desc {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Argo tools</h1>
			<p class="lede">
				Argo is the setup that runs a good part of my admin and side projects: a
				Claude Code session, a folder of plain-text files, a task manager it can
				write to, and three rules. These are the tools that came out of it.
			</p>

			{
				intro && (
					<a class="start" href={`/argo-tools/${intro.id}/`}>
						<span class="kicker">Start here</span>
						<h2>{intro.data.title}</h2>
						<p>{intro.data.description}</p>
					</a>
				)
			}

			<h2 class="section">Posts</h2>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/argo-tools/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="desc">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
