---
// The home page: who he is, then what he built. No figures — 16.09.2026, his
// call; see design.md. src/data/figures.ts is still on disk because the
// data/data.db export job is planned against it, but nothing reads it now.
import { getCollection } from 'astro:content';
import ProjectRows from '../components/ProjectRows.astro';
import Base from '../layouts/Base.astro';
// SITE_DESCRIPTION still feeds <meta> and the RSS feed through Base; it no
// longer prints on the page, because it said the same thing as the paragraph
// below the name. One of the two had to go — 16.09.2026, Carmine's call.
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection('writing')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const swiss = (d: Date) =>
	d.toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
	<section class="masthead">
		<h1>Run the <span class="hl">Numbers</span></h1>
		<p>
			Ciao. I'm Carmine. Data analyst in Zurich, marathons and HYROX on the side. I
			measure my own training, admin and money, then build the tools that do the
			measuring for me. This is what came out.
		</p>
	</section>

	<h2 class="head" id="built">Built</h2>
	<!-- His sentence, not a derived count: "Two" reads better than "2", and he
	     rewrites the line the day a third thing starts running. -->
	<p class="head-note">
		Two things run every day. One is waiting on data I have not exported yet.
	</p>
	<ProjectRows projects={projects} />

	<h2 class="head" id="written">Written</h2>
	<ul class="reads">
		{
			posts.map((post) => (
				<li>
					<a href={`/writing/${post.id}/`}>
						<span>{post.data.title}</span>
						<span class="when">{swiss(post.data.pubDate)}</span>
					</a>
				</li>
			))
		}
	</ul>
</Base>
