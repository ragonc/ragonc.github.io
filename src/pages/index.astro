---
// Stat-led home. Masthead, the figures, the supporting strip, Built, Written.
// The figures are hand-entered in src/data/figures.ts; the rows and the reads
// come from the content collections.
import { getCollection } from 'astro:content';
import ProjectRows from '../components/ProjectRows.astro';
import { FIGURES, STRIP } from '../data/figures';
import Base from '../layouts/Base.astro';
import { LAST_MEASURED, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection('writing')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const swiss = (d: Date) =>
	d.toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
	<section class="masthead">
		<h1>Run the <span class="hl">Numbers</span></h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>

	<section class="stat-hero">
		<div class="figures">
			{
				FIGURES.map((f, i) => (
					<div class:list={['fig-row', { 'is-pending': f.value === null }]}>
						<p class="fig-label">{f.label}</p>
						<p class:list={['figure', 'tnum', { 'figure-2': i > 0 }]}>
							{f.value === null ? (
								<span aria-label="not counted yet">&mdash;</span>
							) : (
								<span>{f.value}</span>
							)}
							<span class="unit">{f.unit}</span>
						</p>
						{f.note && <p class="fig-note">{f.note}</p>}
					</div>
				))
			}
		</div>
		<div class="qualifier-col">
			<p class="qualifier">
				I'm Carmine. Data analyst in Zurich, marathons and HYROX on the side. I measure my
				own training, admin and money, then build the tools that do the measuring for me.
				This is what came out.
			</p>
			<a class="chip" href="#built">The things I built &rarr;</a>
		</div>
	</section>

	<dl class="strip tnum">
		{
			STRIP.map((s) => (
				<div>
					<dt>{s.label}</dt>
					<dd>
						{s.value}
						<small>{s.qualifier}</small>
					</dd>
				</div>
			))
		}
	</dl>
	<p class="sourceline">
		Figures pulled from my own database on {LAST_MEASURED}. Updated by hand until the
		export runs itself.
	</p>

	<h2 class="head" id="built">Built</h2>
	<!-- His sentence, not a derived count: "Two" reads better than "2", and he
	     rewrites the line the day a third thing starts running. -->
	<p class="head-note">
		Two things run every day. One is waiting on data I have not exported yet.
	</p>
	<ProjectRows projects={projects} />

	<h2 class="head" id="written">Written</h2>
	<ul class="reads">
		{
			posts.map((post) => (
				<li>
					<a href={`/writing/${post.id}/`}>
						<span>{post.data.title}</span>
						<span class="when">{swiss(post.data.pubDate)}</span>
					</a>
				</li>
			))
		}
	</ul>
</Base>
