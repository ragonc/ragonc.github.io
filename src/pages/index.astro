---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Run the Numbers</h1>
      <p class="intro">
        I'm Carmine — a data analyst in Zurich who trains a lot and can't leave
        a spreadsheet alone. This blog is where I run the numbers on my own
        life: races, budgets, training, and whatever else looks optimizable.
      </p>
      <h2>Latest posts</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <span class="date"><FormattedDate date={post.data.pubDate} /></span>
          </li>
        ))}
      </ul>
      <p><a href="/blog/">All posts →</a></p>
    </main>
    <Footer />
    <style>
      .intro { font-size: 1.15em; max-width: 42em; }
      .post-list { list-style: none; padding: 0; }
      .post-list li { margin: 0.75em 0; }
      .post-list .date { color: var(--gray, #666); margin-left: 0.75em; font-size: 0.9em; }
    </style>
  </body>
</html>