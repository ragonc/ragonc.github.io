---
// The shell every page sits in: head, route layer, skip link, nav, footer.
// The mockup repeated this markup in each file; here it is said once.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RouteMap from '../components/RouteMap.astro';

interface Props {
	title: string;
	description: string;
	home?: boolean;
}

const { title, description, home = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<RouteMap />
		<a class="skip" href="#main">Skip to content</a>
		<div class="shell">
			<div class="page">
				<Header home={home} />
				<main id="main">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
	</body>
</html>
